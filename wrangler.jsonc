{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tongcraft-cdn",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
